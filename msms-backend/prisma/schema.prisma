generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id           String     @id @default(cuid())
  name         String
  plan         String     @default("PRO") // "TRIAL" | "SIMPLE" | "PRO"
  trialEndsAt  DateTime?  // set only when plan = "TRIAL"; cleared on upgrade
  createdAt    DateTime   @default(now())
  users        User[]
  products     Product[]
  sales        Sale[]
  purchases    Purchase[]
  secondhand   SecondhandRecord[]
}

model User {
  id                 String     @id @default(cuid())
  username           String     @unique
  passwordHash       String
  role               String     @default("staff")
  email              String?
  resetOtpHash       String?
  resetOtpExpiresAt  DateTime?
  createdAt          DateTime   @default(now())
  shop               Shop       @relation(fields: [shopId], references: [id])
  shopId             String
  sales              Sale[]
  purchases          Purchase[]

  @@index([shopId])
}

model Product {
  id            String            @id @default(cuid())
  name          String
  brand         String
  category      String            @default("phone")
  condition     String            @default("new")
  imei          String?
  barcode       String?
  purchasePrice Float
  salePrice     Float
  stock         Int               @default(0)
  storage       String?
  color         String?
  ram           String?
  isSecondhand  Boolean           @default(false)
  isDeleted     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  shop          Shop              @relation(fields: [shopId], references: [id])
  shopId        String
  sales         Sale[]
  purchases     Purchase[]
  secondhand    SecondhandRecord?

  @@index([imei])
  @@index([barcode])
  @@index([shopId])
}

model Sale {
  id                 String            @id @default(cuid())
  invoiceNo          String
  product            Product           @relation(fields: [productId], references: [id])
  productId          String
  recordedBy         User              @relation(fields: [userId], references: [id])
  userId             String
  shop               Shop              @relation(fields: [shopId], references: [id])
  shopId             String
  secondhand         SecondhandRecord? @relation(fields: [secondhandId], references: [id])
  secondhandId       String?
  quantity           Int
  salePrice          Float
  totalAmount        Float
  profit             Float
  customerName       String?
  customerPhone      String?
  customerCnic       String?
  imei               String?
  paymentType        String            @default("CASH") // "CASH" | "INSTALLMENT"
  installmentDueDate DateTime?
  installmentPaid    Boolean           @default(false)
  guarantors         Guarantor[]
  createdAt          DateTime          @default(now())

  @@unique([shopId, invoiceNo])
  @@index([paymentType, installmentPaid, installmentDueDate])
  @@index([shopId])
}

model Guarantor {
  id        String   @id @default(cuid())
  sale      Sale     @relation(fields: [saleId], references: [id])
  saleId    String
  name      String?
  cnic      String
  phone     String
  createdAt DateTime @default(now())

  @@index([saleId])
}

model Purchase {
  id            String   @id @default(cuid())
  product       Product  @relation(fields: [productId], references: [id])
  productId     String
  recordedBy    User     @relation(fields: [userId], references: [id])
  userId        String
  shop          Shop     @relation(fields: [shopId], references: [id])
  shopId        String
  quantity      Int
  purchasePrice Float
  supplierName  String?
  supplierPhone String?
  createdAt     DateTime @default(now())

  @@index([shopId])
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String
  plan          String      // "SIMPLE" | "PRO"
  amount        Int
  status        String      @default("PENDING") // "PENDING" | "PAID" | "CANCELLED"
  transactionId String?
  screenshotUrl String?     // Cloudinary URL of payment proof uploaded by customer
  notes         String?
  licenseKey    LicenseKey?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model LicenseKey {
  key           String    @id @default(uuid())
  order         Order     @relation(fields: [orderId], references: [id])
  orderId       String    @unique
  plan          String
  isActivated   Boolean   @default(false)
  activatedAt   DateTime?
  shopName      String?
  createdAt     DateTime  @default(now())
}

// ── Shared product catalog ────────────────────────────────────────────────────
// Any shopkeeper who scans an unknown barcode and fills it in manually
// contributes the entry here. All future scans of the same barcode across
// all shops get instant auto-fill — the catalog grows with every new product.
model ProductCatalog {
  id       String   @id @default(cuid())
  barcode  String   @unique
  name     String
  brand    String
  category String   @default("phone")
  addedAt  DateTime @default(now())

  @@index([barcode])
}

model SecondhandRecord {
  id             String   @id @default(cuid())
  product        Product  @relation(fields: [productId], references: [id])
  productId      String   @unique
  shop           Shop     @relation(fields: [shopId], references: [id])
  shopId         String
  mobileName     String
  brand          String
  imei           String?
  sellerName     String
  sellerCnic     String
  sellerPhone    String
  purchasePrice  Float
  notes          String?
  sellerPhotoUrl String?
  cnicPhotoUrl   String?
  isSold         Boolean  @default(false)
  createdAt      DateTime @default(now())
  sales          Sale[]

  @@index([shopId])
}
